        <engine:ScrollView name="ScrollView" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="AlwaysVisible" style="height: 100%; flex-shrink: 0; width: 100%;">
            <engine:VisualElement name="ApartmentSidebarEntry" style="flex-grow: 0; width: 100%; height: 6%; background-color: rgb(255, 255, 255); flex-shrink: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 2px; border-left-width: 0; border-left-color: rgb(137, 137, 137); border-right-color: rgb(137, 137, 137); border-top-color: rgb(137, 137, 137); border-bottom-color: rgb(137, 137, 137);">
                <engine:Label text="Apartment 000" style="font-size: 5%; height: 49%; -unity-text-align: middle-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                <engine:VisualElement name="Bed" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/_Images/bed.png?fileID=2800000&amp;guid=d113ed2d5f11ea44a98f3ddc1f2118f8&amp;type=3#bed&quot;); background-size: 20px 20px; flex-shrink: 0; width: 20px; height: 20px;" />
